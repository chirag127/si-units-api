{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chirag127.github.io/si-units-and-measurements/schemas/data.json",
  "title": "SI Units and Measurements",
  "type": "array",
  "items": {
    "type": "object",
    "required": [
      "id",
      "name",
      "symbol",
      "quantity",
      "definition"
    ],
    "properties": {
      "id": {
        "type": "string",
        "pattern": "^[A-Z0-9-]+$"
      },
      "name": {
        "type": "string"
      },
      "symbol": {
        "type": "string"
      },
      "quantity": {
        "type": "string"
      },
      "definition": {
        "type": "string"
      }
    }
  }
}
